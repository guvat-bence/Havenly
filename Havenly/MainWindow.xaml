<Window x:Class="Havenly.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="clr-namespace:Havenly"
    mc:Ignorable="d"
    Title="MainWindow" Height="900" Width="1200">

    <Grid Background="#4a3d94">
        <Grid.ColumnDefinitions>
            <ColumnDefinition />
            <ColumnDefinition Width="0*" />
        </Grid.ColumnDefinitions>

        <Label Content="Havenly adminisztrátor UI"
            HorizontalAlignment="Left"
            Margin="63,22,0,0"
            VerticalAlignment="Top"
            Height="72"
            Width="605"
            FontSize="50"
            Name="test" Grid.Column="1" />

        <Border Margin="0,58,104,0"
            HorizontalAlignment="Right"
            VerticalAlignment="Top"
            Width="291"
            BorderThickness="2"
            BorderBrush="Transparent"
            CornerRadius="20"
            Height="794"
            Padding="10"
            Background="#2f275e">
            <UniformGrid Rows="10" Columns="1" Margin="-12,-12,177,-12">

                <Button Height="80"
                        Width="80"
                        MaxHeight="80"
                        MaxWidth="80"
                        Name="citybtn" Click="citybtn_Click">
                    <Image Source="image/city.png"
                            MaxHeight="72"
                            MaxWidth="60"
                            Stretch="Uniform" />
                </Button>

                <Button Height="80"
                        Width="80"
                        MaxHeight="80"
                        MaxWidth="80"
                        Name="countrybtn" Click="countrybtn_Click">
                    <Image Source="image/country.png"
                            MaxHeight="81"
                            MaxWidth="63"
                            Stretch="Uniform" />
                </Button>

                <Button Height="80"
                        Width="80"
                        MaxHeight="80"
                        MaxWidth="80"
                        Name="detailsbtn" Click="detailsbtn_Click">
                    <Image Source="image/details.png"
                            MaxHeight="80"
                            MaxWidth="63"
                            Stretch="Uniform" />
                </Button>

                <Button Height="80"
                        Width="80"
                        MaxHeight="80"
                        MaxWidth="80"
                        Name="experience_button" Click="experience_button_Click_1">
                    <Image Source="/image/experience.png"
                            MaxHeight="69"
                            MaxWidth="65"
                            Stretch="Uniform" />
                </Button>

                <Button Height="80"
                        Width="80"
                        MaxHeight="80"
                        MaxWidth="80"
                        Name="favouritebtn" Click="favouritebtn_Click">
                    <Image Source="image/favourite.png"
                            MaxHeight="47"
                            MaxWidth="52"
                            Stretch="Uniform" />
                </Button>

                <Button Height="80"
                        Width="80"
                        MaxHeight="80"
                        MaxWidth="80"
                        Name="historybtn" Click="historybtn_Click">
                    <Image Source="image/history.png"
                            MaxHeight="52"
                            MaxWidth="54"
                            Stretch="Uniform" />
                </Button>

                <Button Height="80"
                        Width="80"
                        MaxHeight="80"
                        MaxWidth="80"
                        Name="usersbtn" Click="usersbtn_Click">
                    <Image Source="image/user.png"
                            MaxHeight="108"
                            MaxWidth="96"
                            Stretch="Uniform" />
                </Button>

                <Button Height="80"
                        Width="80"
                        MaxHeight="80"
                        MaxWidth="80"
                        Name="accommodationbtn" Click="accommodationbtn_Click">
                    <Image Source="/image/szallas.png"
                            MaxHeight="93"
                            MaxWidth="96"
                            Stretch="Uniform" />
                </Button>
                <Button Height="80"
                        Width="80"
                        MaxHeight="80"
                        MaxWidth="80"
                        Name="card_networks_btn" 
                        Click="card_networks_btn_Click">
                    <Image Source="/card_network.png"
                            MaxHeight="93"
                            MaxWidth="96"
                            Stretch="Uniform" />
                </Button>
                <Button Height="80"
                        Width="80"
                        MaxHeight="80"
                        MaxWidth="80"
                        Name="currencybtn" 
                        Click="currencybtn_Click">
                    <Image Source="/currency.png"
                            MaxHeight="93"
                            MaxWidth="96"
                            Stretch="Uniform" />
                </Button>

            </UniformGrid>
        </Border>

        <Border Background="#2f275e" 
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Padding="10"
                Height="536"
                Width="706"
                CornerRadius="20"
                BorderBrush="Transparent"
                BorderThickness="2" 
                Margin="10,106,0,0">
            <DataGrid Background="Transparent" 
                      BorderBrush="Transparent" 
                      d:ItemsSource="{d:SampleData ItemCount=5}"
                      VerticalContentAlignment="Center"
                      HorizontalContentAlignment="Center"
                      VerticalAlignment="Top"
                      Name="datagrid0"
                      PreviewKeyDown="datagrid0_PreviewKeyDown"
                      MouseDoubleClick="datagrid0_MouseDoubleClick"
                      HorizontalAlignment="Center" Height="499" Width="634" Margin="0,15,0,0"/>
        </Border>

        <Label Content="City" 
               HorizontalAlignment="Right" 
               VerticalContentAlignment="Center"
               HorizontalContentAlignment="Center"
               Margin="0,66,104,0" 
               VerticalAlignment="Top"
               Height="69" 
               Width="202"
               FontSize="30"/>

        <Label Content="Country" 
            HorizontalAlignment="Right" 
            HorizontalContentAlignment="Center"
            VerticalContentAlignment="Center"
            Margin="0,140,104,0" 
            VerticalAlignment="Top"
            Height="68" 
            Width="202"
            FontSize="30"/>

        <Label Content="Details" 
            HorizontalAlignment="Right" 
            HorizontalContentAlignment="Center"
            VerticalContentAlignment="Center"
            Margin="0,219,104,0" 
            VerticalAlignment="Top"
            Height="75" 
            Width="202"
            FontSize="30"/>

        <Label Content="Experience" 
            HorizontalAlignment="Right" 
            HorizontalContentAlignment="Center"
            VerticalContentAlignment="Center"
            Margin="0,303,104,0" 
            VerticalAlignment="Top"
            Height="71" 
            Width="202"
            FontSize="30"/>

        <Label Content="Favourite" 
            HorizontalAlignment="Right" 
            HorizontalContentAlignment="Center"
            VerticalContentAlignment="Center"
            Margin="0,389,104,0" 
            VerticalAlignment="Top"
            Height="66" 
            Width="202"
            FontSize="30"/>

        <Label Content="History" 
            HorizontalAlignment="Right" 
            HorizontalContentAlignment="Center"
            VerticalContentAlignment="Center"
            Margin="0,455,104,0" 
            VerticalAlignment="Top"
            Height="78" 
            Width="202"
            FontSize="30"/>
        <Label Content="Users" 
            HorizontalAlignment="Right" 
            HorizontalContentAlignment="Center"
            VerticalContentAlignment="Center"
            Margin="0,538,104,0" 
            VerticalAlignment="Top"
            Height="70" 
            Width="202"
            FontSize="30"/>
        <Label Content="Accommodation" 
            HorizontalAlignment="Right" 
            HorizontalContentAlignment="Center"
            VerticalContentAlignment="Center"
            Margin="0,620,104,0" 
            VerticalAlignment="Top"
            Height="74" 
            Width="202"
            FontSize="25"/>

        <Label Content="Táblák"
            HorizontalAlignment="Right"
            Margin="0,10,124,0"
            VerticalAlignment="Top"
            VerticalContentAlignment="Center"
            HorizontalContentAlignment="Center"
            Height="56"
            Width="252"
            FontSize="30"/>

        <Border BorderBrush="Black" 
                BorderThickness="0" 
                Margin="10,0,0,12"
                HorizontalAlignment="Left"
               VerticalAlignment="Bottom" 
                Height="136" 
                RenderTransformOrigin="0.5,0.5" 
                Width="706"
                CornerRadius="20"
                Background="#2f275e">
            <UniformGrid Columns="3" Rows="1">
                <Button
                        Name="addButton"
                        MaxHeight="80"
                        MaxWidth="80" Margin="30,1,30,0" Click="addButton_Click">
                    <Image Source="image/create.png"
                            MaxHeight="93"
                            MaxWidth="96"
                            Stretch="Uniform" Height="70" />
                </Button>
                <Button
                    Name="editButton"
                    MaxHeight="80"
                    MaxWidth="80" Margin="30,1,30,0" Click="editButton_Click">
                    <Image Source="image/modify.png"
                        MaxHeight="93"
                        MaxWidth="96"
                        Stretch="Uniform" Height="70" />
                </Button>
                <Button
                    Name="removeButton"
                    MaxHeight="80"
                    MaxWidth="80" Margin="30,1,30,0" Click="removeButton_Click">
                    <Image Source="image/delete.png"
                        MaxHeight="93"
                        MaxWidth="96"
                        Stretch="Uniform" Height="70" />
                </Button>
            </UniformGrid>
        </Border>

        <Label Content="Havenly admin" 
               HorizontalAlignment="Left" 
               FontSize="40"
               Height="56" 
               Margin="27,22,0,0" 
               VerticalAlignment="Top" Width="300"/>
        <Label Content="Card networks" 
            HorizontalAlignment="Right" 
            HorizontalContentAlignment="Center"
            VerticalContentAlignment="Center"
            Margin="0,699,104,0" 
            VerticalAlignment="Top"
            Height="74" 
            Width="202"
            FontSize="25"/>
        <Label Content="Currency" 
            HorizontalAlignment="Right" 
            HorizontalContentAlignment="Center"
            VerticalContentAlignment="Center"
            Margin="0,778,104,0" 
            VerticalAlignment="Top"
            Height="74" 
            Width="202"
            FontSize="25"/>
    </Grid>
</Window>