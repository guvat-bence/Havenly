<Window x:Class="Havenly.login"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Havenly"
        mc:Ignorable="d"
        Title="login" Height="450" Width="439">
    <Grid Background="#4a3d94">
        <Border BorderBrush="Black" 
            BorderThickness="0"
            HorizontalAlignment="Center"
            VerticalAlignment="Center" 
            Height="231" 
            RenderTransformOrigin="0.5,0.5" 
            Width="325"
            CornerRadius="20"
            Background="#2f275e">
            <UniformGrid Columns="2" Rows="3">
                <Label Content="Email cim:"
                       HorizontalAlignment="Left"
                       Height="30" Margin="23,45,0,0"
                       VerticalAlignment="Top"
                       Width="100"/>
                <TextBox HorizontalAlignment="Left"
                         Name="emailTextBox"
                         Height="26"
                         Margin="-20,45,0,-1"
                         TextWrapping="Wrap"
                         VerticalContentAlignment="Bottom"
                         Width="160"
                         TextChanged="emailTextBox_TextChanged"/>
                <Label Content="Jelszó:"
                       HorizontalAlignment="Left"
                       Height="30"
                       Margin="23,0,0,0"
                       VerticalAlignment="Center"
                       Width="100"/>
                <PasswordBox HorizontalAlignment="Left"
                             Name="passwordTextBox"
                             Height="26"
                             Margin="-20,0,0,0"
                             VerticalAlignment="Center"
                             Width="160"
                             PasswordChanged="passwordTextBox_PasswordChanged"/>

                <Button MaxHeight="80"
                        MaxWidth="80"
                        Name="loginButton"
                        Margin="41,10,-104,19" 
                        Click="loginButton_Click">
                    <Image Source="/login.png"
                           MaxHeight="72"
                           MaxWidth="60"
                           Stretch="Uniform"/>
                </Button>
            </UniformGrid>
        </Border>
    </Grid>
</Window>
