<Window x:Class="Havenly.Datas"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Havenly"
        mc:Ignorable="d"
        Title="Datas" Height="623" Width="776">

    <Grid Background="#4a3d94" Margin="0,0,0,-6">

        <Border Background="#2f275e" 
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            Padding="10"
            Height="498"
            Width="300"
            CornerRadius="20"
            BorderBrush="Transparent"
            BorderThickness="2" 
            Margin="72,10,0,0">
            <UniformGrid>
                <StackPanel Name="mainTextboxsesStackPanel" Margin="-2,-2,-2,-2" RenderTransformOrigin="0.5,0.5">
                </StackPanel>
            </UniformGrid>
            
        </Border>
        <Border Background="#2f275e" 
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            Padding="10"
            Height="498"
            Width="100"
            CornerRadius="20"
            BorderBrush="Transparent"
            BorderThickness="2" 
            Margin="10,10,0,0">
            <UniformGrid>
                <StackPanel Name="mainLabelsStackPanel" Margin="-12,-2,-12,-12">
                </StackPanel>
            </UniformGrid>
            
        </Border>
        
        <Border Background="#2f275e" 
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            Padding="10"
            Height="300"
            Width="360"
            CornerRadius="20"
            BorderBrush="Transparent"
            BorderThickness="2" 
            Margin="406,208,0,0">
            <StackPanel Name="bigTextboxStackPanel" Margin="-12,-2,-12,-2">
            </StackPanel>
        </Border>
        <Border Background="#2f275e" 
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            Padding="10"
            Height="231"
            Width="360"
            CornerRadius="20"
            BorderBrush="Transparent"
            BorderThickness="2"
            Margin="406,10,0,0">
            <StackPanel Name="dateTimeStackPanel" Margin="-12,-2,-12,-2"/>
        </Border>

        <Border BorderBrush="Black" 
            BorderThickness="0" 
            Margin="0,530,0,0"
            HorizontalAlignment="Center"
            VerticalAlignment="Top" 
            Height="70" 
            RenderTransformOrigin="0.5,0.5" 
            Width="277"
            CornerRadius="20"
            Background="#2f275e">
            <UniformGrid Columns="2" Rows="1" HorizontalAlignment="Center" Width="277">
                <Button
                    x:Name="addButton"
                    MaxHeight="80"
                    MaxWidth="80">
                    <Image Source="/image/approve.png"
                        MaxHeight="93"
                        MaxWidth="96"
                        Stretch="Uniform" Height="70"/>
                </Button>
                <Button
                    x:Name="removeButton"
                    MaxHeight="80"
                    MaxWidth="80" Margin="0,0,1,0">
                    <Image Source="/image/decline.png"
                        MaxHeight="93"
                        MaxWidth="96"
                        Stretch="Uniform" Height="70" />
                </Button>
            </UniformGrid>
        </Border>
        <Border Background="#2f275e" 
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            Padding="10"
            Height="498"
            Width="300"
            CornerRadius="20"
            BorderBrush="Transparent"
            BorderThickness="2" 
            Margin="468,10,0,0"
            Name="extra_textboxses2"
            Visibility="Hidden">
            <StackPanel Name="extra_textboxsesStackPanel2" Margin="-2,-2,-2,-2" RenderTransformOrigin="0.5,0.5"/>
        </Border>
        <Border Background="#2f275e" 
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            Padding="10"
            Height="498"
            Width="100"
            CornerRadius="20"
            BorderBrush="Transparent"
            BorderThickness="2" 
            Margin="406,10,0,0"
            Visibility="Hidden"
            Name="extra_textboxses1">
            <StackPanel Name="extra_textboxsesStackPanel" Margin="-12,-2,-12,-12"/>
        </Border>
        <Border Background="#2f275e" 
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            Padding="10"
            Height="498"
            Width="200"
            CornerRadius="20"
            BorderBrush="Transparent"
            BorderThickness="2" 
            Margin="10,10,0,0"
            Visibility="Hidden"
            Name="CheckBoxLabelBorder">
            <StackPanel Name="CheckBoxLabelsStackPanel" Margin="-12,-2,-12,-12"/>
        </Border>
        <Border Background="#2f275e" 
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            Padding="10"
            Height="498"
            Width="200"
            CornerRadius="20"
            BorderBrush="Transparent"
            BorderThickness="2" 
            Margin="172,10,0,0"
            Visibility="Hidden"
            Name="CheckBoxBorder">
            <StackPanel Name="CheckBoxStackPanel" Margin="-12,-2,-12,-12"/>
        </Border>

    </Grid>
</Window>
